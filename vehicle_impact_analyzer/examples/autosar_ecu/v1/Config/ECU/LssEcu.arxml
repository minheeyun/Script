<?xml version="1.0" encoding="UTF-8"?>
<!-- 예제 ECU 추출(ECU extract): SWC 4개(SWC_Lamp는 다른 ECU에 배치되어 이 코드에는 없음), 컴포지션 3개 -->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Swcs</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>SWC_Pwm</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE><SHORT-NAME>PpPwmDuty</SHORT-NAME></P-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE><SHORT-NAME>RpVehicleSpeed</SHORT-NAME></R-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE><SHORT-NAME>RpDiagFault</SHORT-NAME></R-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>IB_SWC_Pwm</SHORT-NAME>
              <EVENTS>
                <TIMING-EVENT>
                  <SHORT-NAME>TE_RE_PwmMain</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Swcs/SWC_Pwm/IB_SWC_Pwm/RE_PwmMain</START-ON-EVENT-REF>
                  <PERIOD>0.01</PERIOD>
                </TIMING-EVENT>
              </EVENTS>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>RE_PwmMain</SHORT-NAME>
                  <SYMBOL>Pwm_MainFunction</SYMBOL>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>
        <SENSOR-ACTUATOR-SW-COMPONENT-TYPE>
          <SHORT-NAME>SWC_Speed</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE><SHORT-NAME>PpVehicleSpeed</SHORT-NAME></P-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE><SHORT-NAME>RpSpeedRaw</SHORT-NAME></R-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>IB_SWC_Speed</SHORT-NAME>
              <EVENTS>
                <TIMING-EVENT>
                  <SHORT-NAME>TE_RE_SpdMain</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Swcs/SWC_Speed/IB_SWC_Speed/RE_SpdMain</START-ON-EVENT-REF>
                  <PERIOD>0.01</PERIOD>
                </TIMING-EVENT>
              </EVENTS>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>RE_SpdMain</SHORT-NAME>
                  <SYMBOL>Spd_MainFunction</SYMBOL>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </SENSOR-ACTUATOR-SW-COMPONENT-TYPE>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>SWC_Diag</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE><SHORT-NAME>PpDiagFault</SHORT-NAME></P-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE><SHORT-NAME>RpVehicleSpeed</SHORT-NAME></R-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>IB_SWC_Diag</SHORT-NAME>
              <EVENTS>
                <TIMING-EVENT>
                  <SHORT-NAME>TE_RE_DiagMain</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Swcs/SWC_Diag/IB_SWC_Diag/RE_DiagMain</START-ON-EVENT-REF>
                  <PERIOD>0.01</PERIOD>
                </TIMING-EVENT>
              </EVENTS>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>RE_DiagMain</SHORT-NAME>
                  <SYMBOL>Diag_MainFunction</SYMBOL>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>SWC_Lamp</SHORT-NAME>
          <PORTS>
            <R-PORT-PROTOTYPE><SHORT-NAME>RpDiagFault</SHORT-NAME></R-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>IB_SWC_Lamp</SHORT-NAME>
              <EVENTS>
                <TIMING-EVENT>
                  <SHORT-NAME>TE_RE_LampMain</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Swcs/SWC_Lamp/IB_SWC_Lamp/RE_LampMain</START-ON-EVENT-REF>
                  <PERIOD>0.01</PERIOD>
                </TIMING-EVENT>
              </EVENTS>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>RE_LampMain</SHORT-NAME>
                  <SYMBOL>Lamp_MainFunction</SYMBOL>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>
        <COMPOSITION-SW-COMPONENT-TYPE>
          <SHORT-NAME>Comp_Chassis</SHORT-NAME>
          <COMPONENTS>
            <SW-COMPONENT-PROTOTYPE><SHORT-NAME>Pwm</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/Swcs/SWC_Pwm</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
            <SW-COMPONENT-PROTOTYPE><SHORT-NAME>Speed</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/Swcs/SWC_Speed</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
          </COMPONENTS>
        </COMPOSITION-SW-COMPONENT-TYPE>
        <COMPOSITION-SW-COMPONENT-TYPE>
          <SHORT-NAME>Comp_Safety</SHORT-NAME>
          <COMPONENTS>
            <SW-COMPONENT-PROTOTYPE><SHORT-NAME>Diag</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/Swcs/SWC_Diag</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
          </COMPONENTS>
        </COMPOSITION-SW-COMPONENT-TYPE>
        <COMPOSITION-SW-COMPONENT-TYPE>
          <SHORT-NAME>Comp_Body</SHORT-NAME>
          <COMPONENTS>
            <SW-COMPONENT-PROTOTYPE><SHORT-NAME>Lamp</SHORT-NAME><TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/Swcs/SWC_Lamp</TYPE-TREF></SW-COMPONENT-PROTOTYPE>
          </COMPONENTS>
        </COMPOSITION-SW-COMPONENT-TYPE>
        <SWC-IMPLEMENTATION>
          <SHORT-NAME>Impl_Diag</SHORT-NAME>
          <CODE-DESCRIPTORS>
            <CODE>
              <SHORT-NAME>Src</SHORT-NAME>
              <ARTIFACT-DESCRIPTORS>
                <AUTOSAR-ENGINEERING-OBJECT><SHORT-LABEL>diag.c</SHORT-LABEL><CATEGORY>SWSRC</CATEGORY></AUTOSAR-ENGINEERING-OBJECT>
              </ARTIFACT-DESCRIPTORS>
            </CODE>
          </CODE-DESCRIPTORS>
          <BEHAVIOR-REF DEST="SWC-INTERNAL-BEHAVIOR">/Swcs/SWC_Diag/IB_SWC_Diag</BEHAVIOR-REF>
        </SWC-IMPLEMENTATION>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
